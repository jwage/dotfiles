# Linked to ~/.zshrc on both macOS and Omarchy Linux (default login shell on
# both; bash/bashrc is still tracked/linked on Linux as a fallback for
# non-interactive/bash-specific tooling).

# Omarchy environment (OMARCHY_PATH + PATH); this file doesn't exist on macOS
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# Point at the systemd-activated ssh-agent socket (environment.d/ssh-agent.conf
# sets this for graphical logins already; this covers shells started before
# that took effect, and is a no-op on macOS where the socket never exists).
[[ -z "$SSH_AUTH_SOCK" && -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]] && export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

DOTFILES="$(cd "$(dirname "$(realpath "$HOME/.zshrc")")/.." && pwd)"
# shellcheck source=../shell/env.sh
source "$DOTFILES/shell/env.sh"

# Same toolchain as Omarchy (node, gh, claude, codex). On Linux, env-bootstrap
# may already have activated mise; a second activate is harmless.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# oh-my-zsh for plugins only (installed separately). Prompt is Starship so
# both machines match Omarchy's stock look; robbyrussell is a fallback if
# starship is not on PATH yet.
export ZSH="$HOME/.oh-my-zsh"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
# Fall back to completion-based suggestions when history has no match --
# on a fresh machine (little accumulated $HISTFILE yet) the default
# history-only strategy has almost nothing to suggest from.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
if command -v starship >/dev/null 2>&1; then
  ZSH_THEME=""
else
  ZSH_THEME="robbyrussell"
fi
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# Fallback Node from nvm.fish if mise is not installed. No-op on Omarchy.
if ! command -v mise >/dev/null 2>&1 && [[ -d "$HOME/.local/share/nvm" ]]; then
  export NVM_DIR="$HOME/.local/share/nvm"
  _nvm_version=""
  if [[ -r "$NVM_DIR/alias/default" ]]; then
    _nvm_version="${$(<"$NVM_DIR/alias/default")%%$'\n'*}"
  fi
  if [[ -n "$_nvm_version" && -d "$NVM_DIR/$_nvm_version/bin" ]]; then
    export PATH="$NVM_DIR/$_nvm_version/bin:$PATH"
  fi
  unset _nvm_version
fi
