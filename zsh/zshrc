# Linked to ~/.zshrc on both macOS and Omarchy Linux (default login shell on
# both; bash/bashrc is still tracked/linked on Linux as a fallback for
# non-interactive/bash-specific tooling).

# Omarchy environment (OMARCHY_PATH + PATH); this file doesn't exist on macOS
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

DOTFILES="$(cd "$(dirname "$(realpath "$HOME/.zshrc")")/.." && pwd)"
# shellcheck source=../shell/env.sh
source "$DOTFILES/shell/env.sh"

# oh-my-zsh for plugins only (installed separately). Prompt is Starship so
# both machines match Omarchy's stock look; robbyrussell is a fallback if
# starship is not on PATH yet.
export ZSH="$HOME/.oh-my-zsh"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
if command -v starship >/dev/null 2>&1; then
  ZSH_THEME=""
else
  ZSH_THEME="robbyrussell"
fi
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# macOS used fish + nvm.fish (~/.local/share/nvm). Login zsh rebuilds PATH via
# path_helper and does not inherit that, so put the selected Node back. No-op
# on Omarchy, which uses mise and does not have this directory.
if [[ -d "$HOME/.local/share/nvm" ]]; then
  export NVM_DIR="$HOME/.local/share/nvm"
  _nvm_version=""
  if [[ -r "$NVM_DIR/alias/default" ]]; then
    _nvm_version="${$(<"$NVM_DIR/alias/default")%%$'\n'*}"
  fi
  if [[ -n "$_nvm_version" && -d "$NVM_DIR/$_nvm_version/bin" ]]; then
    export PATH="$NVM_DIR/$_nvm_version/bin:$PATH"
  fi
  unset _nvm_version
fi
