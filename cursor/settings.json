{
    "workbench.colorTheme": "Sunburst",
    "editor.fontSize": 16,
    "workbench.iconTheme": null,
    "workbench.colorCustomizations": {
        "[Sunburst]": {
            "activityBar.activeBorder": "#0984e3",
            "activityBar.background": "#0e141a",
            "activityBar.foreground": "#d8dee3",
            "activityBar.inactiveForeground": "#647685",
            "activityBarBadge.background": "#0984e3",
            "activityBarBadge.foreground": "#ffffff",
            "breadcrumb.background": "#151f27",
            "breadcrumb.focusForeground": "#f3f6f8",
            "breadcrumb.foreground": "#647685",
            "button.background": "#0984e3",
            "button.foreground": "#ffffff",
            "commandCenter.background": "#151f27",
            "commandCenter.foreground": "#d8dee3",
            "dropdown.background": "#233644",
            "dropdown.foreground": "#f3f6f8",
            "editorGroupHeader.tabsBackground": "#0e141a",
            "editorWidget.background": "#151f27",
            "editorWidget.border": "#405263",
            "focusBorder": "#0984e3",
            "input.background": "#233644",
            "input.border": "#405263",
            "input.foreground": "#f3f6f8",
            "list.activeSelectionBackground": "#30404f",
            "list.activeSelectionForeground": "#f3f6f8",
            "list.focusBackground": "#30404f",
            "list.hoverBackground": "#233644",
            "list.inactiveSelectionBackground": "#233644",
            "panel.background": "#151f27",
            "panel.border": "#405263",
            "panelTitle.activeBorder": "#0984e3",
            "panelTitle.activeForeground": "#f3f6f8",
            "panelTitle.inactiveForeground": "#647685",
            "peekViewEditor.background": "#151f27",
            "peekViewResult.background": "#0e141a",
            "scrollbarSlider.background": "#40526380",
            "scrollbarSlider.hoverBackground": "#64768580",
            "selection.background": "#30404f80",
            "sideBar.background": "#151f27",
            "sideBar.border": "#405263",
            "sideBar.foreground": "#d8dee3",
            "sideBarSectionHeader.background": "#233644",
            "sideBarSectionHeader.foreground": "#f3f6f8",
            "sideBarTitle.foreground": "#f3f6f8",
            "statusBar.background": "#0e141a",
            "statusBar.debuggingBackground": "#0984e3",
            "statusBar.foreground": "#d8dee3",
            "statusBar.noFolderBackground": "#151f27",
            "statusBarItem.remoteBackground": "#0984e3",
            "statusBarItem.remoteForeground": "#ffffff",
            "tab.activeBackground": "#151f27",
            "tab.activeBorderTop": "#0984e3",
            "tab.activeForeground": "#f3f6f8",
            "tab.inactiveBackground": "#0e141a",
            "tab.inactiveForeground": "#647685",
            "terminal.ansiBlack": "#0e141a",
            "terminal.ansiBlue": "#0984e3",
            "terminal.ansiBrightBlack": "#647685",
            "terminal.ansiBrightBlue": "#0984e3",
            "terminal.ansiBrightCyan": "#46b9f4",
            "terminal.ansiBrightGreen": "#43984d",
            "terminal.ansiBrightMagenta": "#b378c7",
            "terminal.ansiBrightRed": "#bd3f3b",
            "terminal.ansiBrightWhite": "#ffffff",
            "terminal.ansiBrightYellow": "#e8b339",
            "terminal.ansiCyan": "#34c3ff",
            "terminal.ansiGreen": "#43984d",
            "terminal.ansiMagenta": "#b378c7",
            "terminal.ansiRed": "#bd3f3b",
            "terminal.ansiWhite": "#f3f6f8",
            "terminal.ansiYellow": "#e8b339",
            "terminal.background": "#0e141a",
            "terminal.foreground": "#f3f6f8",
            "terminal.selectionBackground": "#30404f",
            "terminalCursor.foreground": "#34c3ff",
            "titleBar.activeBackground": "#0e141a",
            "titleBar.activeForeground": "#f3f6f8",
            "titleBar.border": "#405263",
            "titleBar.inactiveBackground": "#151f27",
            "titleBar.inactiveForeground": "#647685"
        }
    },
    "namespaceResolver.sortAlphabetically": true,
    "psalm.hideStatusMessageWhenRunning": false,
    "search.useIgnoreFiles": false,
    "extensions.ignoreRecommendations": true,
    "phpcs.errorSeverity": 0,
    "phpcs.executablePath": "vendor/bin/phpcs",
    "phpcs.lintOnOpen": false,
    "phpcs.warningSeverity": 0,
    "[php]": {
        "editor.defaultFormatter": "valeryanm.vscode-phpsab"
    },
    "workbench.startupEditor": "none",
    "psalm.analyzedFileExtensions": [
        {
            "scheme": "file",
            "language": "php"
        },
        {
            "scheme": "untitled",
            "language": "php"
        }
    ],
    "phpsab.allowedAutoRulesets": [
        ".phpcs.xml",
        ".phpcs.xml.dist",
        "phpcs.xml",
        "phpcs.xml.dist",
        "phpcs.ruleset.xml",
        "ruleset.xml"
    ],
    "editor.inlineSuggest.enabled": true,
    "githubPullRequests.pullBranch": "never",
    "editor.codeActionsOnSave": {},
    "explorer.confirmDragAndDrop": false,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.copyWithSyntaxHighlighting": false,
    "window.zoomLevel": 1,
    "phpsab.executablePathCBF": "vendor/bin/phpcbf",
    "phpsab.executablePathCS": "vendor/bin/phpcs",
    "[html]": {
        "editor.suggest.insertMode": "replace",
        "editor.wordWrap": "on"
    },
    "[twig]": {
        "editor.wordWrap": "on"
    },
    "psalm.enableVerbose": true,
    "psalm.psalmScriptPath": "vendor/bin/psalm",
    "phpunit.phpunit": "vendor/bin/phpunit",
    "tailwindCSS.colorDecorators": false,
    "php.completion.docblock": false,
    "codesnap.backgroundColor": "",
    "codesnap.boxShadow": "",
    "codesnap.containerPadding": "0",
    "codesnap.transparentBackground": true,
    "window.commandCenter": true,
    "cursor.cpp.disabledLanguages": [
        "plaintext"
    ],
    "claudeCode.preferredLocation": "panel",
    "workbench.editor.enablePreview": false,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "editor.accessibilitySupport": "off",
    "accessibility.signalOptions.volume": 0,
    "claudeCode.selectedModel": "default",
    "cursor.composer.usageSummaryDisplay": "always",
    "window.autoDetectColorScheme": false,
    "git.detectWorktrees": true,
    "git.openRepositoryInParentFolders": "always"
}
