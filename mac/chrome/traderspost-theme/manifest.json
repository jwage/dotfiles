{
    "manifest_version": 3,
    "name": "TradersPost",
    "description": "TradersPost brand chrome for Google Chrome. Applies via chrome.theme API on every start.",
    "version": "1.2.0",
    "permissions": [
        "theme"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
