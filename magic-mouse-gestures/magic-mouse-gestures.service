[Unit]
Description=Magic Mouse 2 swipe gestures (two fingers -> Alt+Left/Right)
Documentation=https://github.com/brenoperucchi/magic-mouse-gestures
# Needs a Wayland session: it sends keys with wtype. Upstream's unit uses
# default.target, which can start it before the compositor exists.
After=graphical-session.target

[Service]
Type=simple
# Symlinked out of this repo by install.sh, not copied into /opt the way
# upstream's installer does it -- edits here take effect on restart.
ExecStart=%h/.local/bin/magic-mouse-gestures
# The daemon prints with plain print(); without this, Python block-buffers
# stdout when it is a journal socket and `journalctl -u` shows nothing at all
# until the buffer fills.
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
