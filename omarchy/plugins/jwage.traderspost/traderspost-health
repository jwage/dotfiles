#!/usr/bin/env python3
"""Collect TradersPost production health from New Relic, as one JSON line.

Run by the jwage.traderspost bar widget on a timer, and useful on its own:

    traderspost-health          # pretty, human-readable
    traderspost-health --json   # the compact line the widget parses

Everything the widget shows comes from one NerdGraph request, so a poll costs a
single round trip no matter how many signals are on screen.

The thresholds are not invented here. Account 6271700 has one alert policy
("TradersPost Policy") whose conditions are the team's own definition of
unhealthy -- live/paper/webhook queue wait above 1000ms, and synthetic check
failures -- so those numbers are mirrored below rather than guessed at. Change
them in New Relic and they should be changed here too; QUEUE_WAIT_CRITICAL_MS is
the one that matters.

The API key is never passed on the command line (it would show up in `ps` for
every user on the box) and never lives in this repo. It comes from the
environment when the shell already has it -- UWSM sources ~/.config/mcp-secrets.env
into the session -- and is read out of that file directly otherwise, which is
what makes this work when run from a plain terminal.
"""

import json
import os
import re
import sys
import urllib.error
import urllib.request

SECRETS_FILE = os.path.expanduser("~/.config/mcp-secrets.env")
NERDGRAPH_URL = "https://api.newrelic.com/graphql"
APP_NAME = "TradersPost Heroku Production"
TIMEOUT_SECONDS = 12

# Mirrors "Elevated Live/Paper/Webhook Queue Wait Time" in TradersPost Policy.
QUEUE_WAIT_CRITICAL_MS = 1000
# No warning tier exists in New Relic (both terms there fire at 1000ms, only the
# duration differs), so this one is ours: half the critical threshold, to give
# the bar dot something to say before the pager goes off.
QUEUE_WAIT_WARNING_MS = 500

ERROR_RATE_CRITICAL_PCT = 5.0
ERROR_RATE_WARNING_PCT = 1.0

# The message names are PHP FQCNs. NRQL escapes a backslash inside a string
# literal by doubling it, so each of these carries \\ where the class has one.
MSG_TRADE = r"OtherTransaction/Custom/App\\Message\\Trading\\StrategySubscriptionMessage"
MSG_WEBHOOK = r"OtherTransaction/Custom/App\\Message\\Trading\\WebhookRequestMessage"
MSG_OUTBOX = r"OtherTransaction/Custom/App\\Outbox\\OutboxMessage"
TXN_WEBHOOK_RECEIVE = "WebTransaction/Custom/trading_webhook_receive"
SYNTHETIC_GUID = "NjI3MTcwMHxTWU5USHxNT05JVE9SfGFmOTllM2Y1LTExOGUtNGU0Yy05MDA1LTllOGFhYzVjMjhkYg"


def credentials():
    """(api_key, account_id), preferring the environment over the secrets file."""
    key = os.environ.get("NEW_RELIC_MCP_API_KEY", "").strip()
    account = os.environ.get("NEW_RELIC_ACCOUNT_ID", "").strip()
    if key and account:
        return key, account

    try:
        with open(SECRETS_FILE, encoding="utf-8") as handle:
            content = handle.read()
    except OSError as error:
        raise RuntimeError(f"cannot read {SECRETS_FILE}: {error.strerror}") from error

    def find(name):
        # Tolerates `export NAME=value`, quoted or bare, with trailing comments.
        match = re.search(
            rf"^\s*(?:export\s+)?{name}\s*=\s*[\"']?([^\"'\s#]+)", content, re.MULTILINE
        )
        return match.group(1) if match else ""

    key = key or find("NEW_RELIC_MCP_API_KEY")
    account = account or find("NEW_RELIC_ACCOUNT_ID")
    if not key:
        raise RuntimeError("NEW_RELIC_MCP_API_KEY not in env or mcp-secrets.env")
    if not account:
        raise RuntimeError("NEW_RELIC_ACCOUNT_ID not in env or mcp-secrets.env")
    return key, account


def build_query(account_id):
    """One NerdGraph document: every signal the cockpit shows, aliased.

    Windows are 5 minutes to match the 300s the alert conditions use for their
    critical terms, so a value here crossing the threshold means the same thing
    New Relic's own evaluation would mean by it.
    """
    app = APP_NAME
    nrql = {
        # ---- Trading execution, in the order a trade actually travels:
        #      receive the webhook over HTTP, relay it through the outbox, handle
        #      it, then place the trade live or on paper. Each stage reports the
        #      same three things so the row shape is identical down the section:
        #      how fast it is flowing, how long it waited in the queue, and how
        #      long the work itself took.
        "receiveRate": (
            f"SELECT rate(count(*), 1 minute) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        "receiveRun": (
            f"SELECT average(duration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        # The front door is synchronous HTTP with no queue in front of it, so it
        # has no wait to report -- the p95 stands in as its second timing, since
        # the average of something this fast and this frequent hides the tail.
        # Web transactions have no queueWaitTime -- that attribute is theirs, set
        # on message consumers. New Relic's own queueDuration is the equivalent:
        # time between the request arriving at the router and the app picking it
        # up, which on Heroku is dyno saturation showing itself.
        "receiveWait": (
            f"SELECT average(queueDuration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        "receiveP95": (
            f"SELECT percentile(duration, 95) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        "outboxRate": (
            f"SELECT rate(count(*), 1 minute) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_OUTBOX}' SINCE 5 minutes ago"
        ),
        "outboxWait": (
            f"SELECT average(queueWaitTime) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_OUTBOX}' SINCE 5 minutes ago"
        ),
        "outboxRun": (
            f"SELECT average(duration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_OUTBOX}' SINCE 5 minutes ago"
        ),
        "handleRate": (
            f"SELECT rate(count(*), 1 minute) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_WEBHOOK}' SINCE 5 minutes ago"
        ),
        "handleWait": (
            f"SELECT average(queueWaitTime) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_WEBHOOK}' SINCE 5 minutes ago"
        ),
        "handleRun": (
            f"SELECT average(duration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_WEBHOOK}' SINCE 5 minutes ago"
        ),
        "liveRate": (
            f"SELECT rate(count(*), 1 minute) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_TRADE}' AND mode = 'live' SINCE 5 minutes ago"
        ),
        "liveWait": (
            f"SELECT average(queueWaitTime) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_TRADE}' AND mode = 'live' SINCE 5 minutes ago"
        ),
        "liveRun": (
            f"SELECT average(duration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_TRADE}' AND mode = 'live' SINCE 5 minutes ago"
        ),
        "paperRate": (
            f"SELECT rate(count(*), 1 minute) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_TRADE}' AND mode = 'paper' SINCE 5 minutes ago"
        ),
        "paperWait": (
            f"SELECT average(queueWaitTime) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_TRADE}' AND mode = 'paper' SINCE 5 minutes ago"
        ),
        "paperRun": (
            f"SELECT average(duration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND name = '{MSG_TRADE}' AND mode = 'paper' SINCE 5 minutes ago"
        ),

        # ---- Traffic around the application. Web figures exclude the webhook
        #      front door, which belongs to the pipeline above: it is the
        #      highest-volume web transaction by an order of magnitude, and
        #      averaged in here it buried both itself and everything else.
        "webThroughput": (
            f"SELECT rate(count(*), 1 minute) AS v FROM Transaction "
            f"WHERE appName = '{app}' AND transactionType = 'Web' "
            f"AND name != '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        "webDuration": (
            f"SELECT average(duration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND transactionType = 'Web' "
            f"AND name != '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        "webQueue": (
            f"SELECT average(queueDuration) * 1000 AS v FROM Transaction "
            f"WHERE appName = '{app}' AND transactionType = 'Web' "
            f"AND name != '{TXN_WEBHOOK_RECEIVE}' SINCE 5 minutes ago"
        ),
        "errorRate": (
            f"SELECT percentage(count(*), WHERE error IS true) AS v FROM Transaction "
            f"WHERE appName = '{app}' SINCE 5 minutes ago"
        ),
        "syntheticFailures": (
            f"SELECT filter(count(*), WHERE result = 'FAILED') AS v FROM SyntheticCheck "
            f"WHERE entityGuid IN ('{SYNTHETIC_GUID}') AND NOT isMute SINCE 5 minutes ago"
        ),

        # ---- External services. Every host the app called, one row each, not
        #      filtered to brokers: Stripe, SendGrid or Google auth going slow is
        #      an ops signal too, and the panel lists the lot slowest-first so
        #      whatever is dragging surfaces regardless of category.
        "externals": (
            f"SELECT average(apm.service.external.host.duration) * 1000 AS v, "
            f"rate(count(apm.service.external.host.duration), 1 minute) AS rpm FROM Metric "
            f"WHERE appName = '{app}' FACET `external.host` "
            f"SINCE 5 minutes ago LIMIT 100"
        ),
    }

    fields = "\n".join(
        f'{alias}: nrql(query: {json.dumps(query)}) {{ results }}'
        for alias, query in nrql.items()
    )

    # Open issues come from the AI/alerts side rather than NRQL: this is the
    # authoritative "is anything actually paging right now", independent of
    # whatever the raw numbers below look like.
    return f"""
{{
  actor {{
    account(id: {account_id}) {{
      {fields}
    }}
    ai: account(id: {account_id}) {{
      aiIssues {{
        issues(filter: {{states: ACTIVATED}}) {{
          issues {{ issueId title priority entityNames }}
        }}
      }}
    }}
  }}
}}
"""


def fetch(api_key, query):
    request = urllib.request.Request(
        NERDGRAPH_URL,
        data=json.dumps({"query": query}).encode("utf-8"),
        headers={"Api-Key": api_key, "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
        return json.loads(response.read().decode("utf-8"))


def scalar(account, alias):
    """First result's single value, or None when the window held no data.

    A quiet 5 minutes and a broken query both come back empty here; the
    difference is that a broken query also lands in the `errors` array, which
    main() surfaces instead of reporting a healthy silence.
    """
    try:
        results = account[alias]["results"]
    except (KeyError, TypeError):
        return None
    if not results:
        return None
    value = results[0].get("v")
    return None if value is None else float(value)


# Pretty names for the hosts we know -- brokers taken from the "Broker APIs" page
# of the TradersPost System dashboard, so the widget and that dashboard agree on
# what to call each endpoint. Anything unlisted falls back to its own hostname,
# which is how a newly added dependency announces itself. Nothing is filtered
# out: a host present in the data is a host present in the panel.
HOST_LABELS = {
    "api.ibkr.com": "IBKR",
    "api.alpaca.markets": "Alpaca",
    "paper-api.alpaca.markets": "Alpaca paper",
    "data.alpaca.markets": "Alpaca data",
    "api.bybit.com": "Bybit",
    "api-testnet.bybit.com": "Bybit paper",
    "api.coinbase.com": "Coinbase",
    "api.binance.com": "Binance",
    "api.etrade.com": "E*TRADE",
    "api.kraken.com": "Kraken",
    "api.robinhood.com": "Robinhood",
    "api.tastytrade.com": "Tastytrade",
    "api.tradestation.com": "TradeStation",
    "sim-api.tradestation.com": "TradeStation paper",
    "signin.tradestation.com": "TradeStation auth",
    "api.tradier.com": "Tradier",
    "sandbox.tradier.com": "Tradier paper",
    "live.tradovateapi.com": "Tradovate",
    "demo.tradovateapi.com": "Tradovate paper",
    "us-oauth-open-api.webull.com": "Webull",
    "api.topstepx.com": "TopstepX",
    "api.thefuturesdesk.projectx.com": "Futures Desk",
    "api.polygon.io": "Polygon data",
    # Not brokers, but on request paths that matter, so listed alongside them
    # rather than hidden.
    "api.stripe.com": "Stripe",
    "api.sendgrid.com": "SendGrid",
    "oauth2.googleapis.com": "Google OAuth",
    "openidconnect.googleapis.com": "Google OIDC",
    "www.google.com": "Google",
    "analytics.traderspost.io": "TradersPost analytics",
}


def externals(account):
    """Every external host called in the window, slowest first.

    Slowest first because that is the order it gets read in: the question this
    list answers is "is a dependency dragging?", and the answer is at the top.

    A host with no calls in the window has no latency to report and so is absent
    rather than shown as zero -- the list is whatever is actually being called
    right now, which is why it changes length through the day.
    """
    try:
        results = account["externals"]["results"]
    except (KeyError, TypeError):
        return []

    out = []
    for row in results or []:
        host = row.get("facet") or row.get("external.host")
        value = row.get("v")
        if host is None or value is None:
            continue
        host = str(host)
        out.append({
            "host": host,
            "label": HOST_LABELS.get(host, host),
            "ms": float(value),
            "rpm": float(row.get("rpm") or 0.0),
        })

    out.sort(key=lambda entry: -entry["ms"])
    return out


def format_ms(value):
    """Same rounding Model.js uses, so the detail column matches the values."""
    if value < 1:
        return "<0.1ms" if value < 0.1 else f"{value:.1f}ms"
    if value < 1000:
        return f"{round(value)}ms"
    return f"{value / 1000:.1f}s" if value < 10000 else f"{round(value / 1000)}s"


def grade_queue(value):
    if value is None:
        return "unknown"
    if value >= QUEUE_WAIT_CRITICAL_MS:
        return "critical"
    if value >= QUEUE_WAIT_WARNING_MS:
        return "warning"
    return "ok"


def grade_error_rate(value):
    if value is None:
        return "unknown"
    if value >= ERROR_RATE_CRITICAL_PCT:
        return "critical"
    if value >= ERROR_RATE_WARNING_PCT:
        return "warning"
    return "ok"


def collect():
    api_key, account_id = credentials()
    payload = fetch(api_key, build_query(account_id))

    # A GraphQL response can carry both data and errors. Only bail out when
    # there is nothing usable -- a single failed sub-query should not blank the
    # whole cockpit.
    account = ((payload.get("data") or {}).get("actor") or {}).get("account")
    if account is None:
        errors = payload.get("errors") or [{"message": "no data returned"}]
        raise RuntimeError("; ".join(str(e.get("message", e)) for e in errors[:3]))

    ai = ((payload.get("data") or {}).get("actor") or {}).get("ai") or {}
    issues = (((ai.get("aiIssues") or {}).get("issues") or {}).get("issues")) or []

    external_list = externals(account)

    # ---- The pipeline, in travel order. Every stage reports the same three
    #      numbers so the rows line up; the front door has no queue in front of
    #      it, so its wait is None and the p95 carries its second timing.
    stages = [
        {
            "key": "receive",
            "label": "Receive Webhook",
            "rate": scalar(account, "receiveRate"),
            "wait": scalar(account, "receiveWait"),
            # Ungraded, unlike the message queues below. This is request queue
            # time, and the 1000ms the alert policy uses for a message queue
            # would be a catastrophe here -- web queueing is measured in single
            # milliseconds. There is no condition in New Relic covering it, so
            # rather than invent a second threshold the number is shown plain.
            "waitGraded": False,
            "run": scalar(account, "receiveRun"),
            "extra": scalar(account, "receiveP95"),
            "extraLabel": "p95",
        },
        {
            "key": "outbox",
            "waitGraded": True,
            "label": "Outbox",
            "rate": scalar(account, "outboxRate"),
            "wait": scalar(account, "outboxWait"),
            "run": scalar(account, "outboxRun"),
        },
        {
            "key": "handle",
            "waitGraded": True,
            "label": "Handle Webhook",
            "rate": scalar(account, "handleRate"),
            "wait": scalar(account, "handleWait"),
            "run": scalar(account, "handleRun"),
        },
        {
            "key": "live",
            "waitGraded": True,
            "label": "Live Trades",
            "rate": scalar(account, "liveRate"),
            "wait": scalar(account, "liveWait"),
            "run": scalar(account, "liveRun"),
        },
        {
            "key": "paper",
            "waitGraded": True,
            "label": "Paper Trades",
            "rate": scalar(account, "paperRate"),
            "wait": scalar(account, "paperWait"),
            "run": scalar(account, "paperRun"),
        },
    ]

    # Grade each stage on its queue wait -- the thing that says "this step is
    # backing up". Live, paper and handle mirror alert conditions exactly.
    #
    # Outbox does not: no condition covers it, so grading it against the same
    # 1000ms is this widget's own extension. It is included because an outbox
    # stall means accepted webhooks are not reaching the handlers at all, which
    # is an incident whether or not New Relic pages for it -- but it does mean
    # the dot can go red with nothing paging. Drop this stage's grade to "info"
    # if the dot should mirror the pager and nothing else.
    for stage in stages:
        gradeable = stage.get("waitGraded") and stage["wait"] is not None
        stage["grade"] = grade_queue(stage["wait"]) if gradeable else "info"

    error_rate = scalar(account, "errorRate")
    synthetic_failures = scalar(account, "syntheticFailures") or 0.0

    metrics = {
        "errorRate": {"value": error_rate, "unit": "%", "grade": grade_error_rate(error_rate),
                      "label": "Error rate"},
        "synthetic": {
            "value": synthetic_failures,
            "unit": "",
            # The alert fires above 3 failures in the window; any failure at all
            # is worth a colour here, since one failed homepage check is already
            # a user-visible event.
            "grade": "critical" if synthetic_failures > 3 else ("warning" if synthetic_failures else "ok"),
            "label": "Homepage check",
        },
        "webThroughput": {"value": scalar(account, "webThroughput"), "unit": "/min",
                          "grade": "info", "label": "Web throughput"},
        # Same request queue time as the receive stage, for everything else on
        # HTTP. Ungraded for the same reason.
        "webQueue": {"value": scalar(account, "webQueue"), "unit": "ms",
                     "grade": "info", "label": "Web queue"},
        "webDuration": {"value": scalar(account, "webDuration"), "unit": "ms",
                        "grade": "info", "label": "Web response"},
    }

    # Open issues outrank everything: New Relic having decided something is
    # paging is a stronger statement than any single number in this window.
    if issues:
        overall = "critical"
    else:
        grades = [m["grade"] for m in metrics.values()] + [st["grade"] for st in stages]
        if "critical" in grades:
            overall = "critical"
        elif "warning" in grades:
            overall = "warning"
        elif all(g in ("unknown", "info") for g in grades):
            # Nothing graded either way -- treat as no-data rather than healthy.
            overall = "unknown"
        else:
            overall = "ok"

    return {
        "ok": True,
        "status": overall,
        "app": APP_NAME,
        "stages": stages,
        "metrics": metrics,
        # Ungraded on purpose. Nothing in New Relic defines what "slow" means
        # for an external call, and this widget does not invent thresholds -- so
        # these carry no colour and no dot, and the slowest-first ordering is
        # what does the work.
        "externals": external_list,
        "issues": [
            {
                "title": str(issue.get("title") or ""),
                "priority": str(issue.get("priority") or ""),
                "entities": issue.get("entityNames") or [],
            }
            for issue in issues
        ],
        "thresholds": {
            "queueWaitWarningMs": QUEUE_WAIT_WARNING_MS,
            "queueWaitCriticalMs": QUEUE_WAIT_CRITICAL_MS,
        },
    }


def format_human(health):
    marks = {"ok": "OK", "warning": "WARN", "critical": "CRIT", "unknown": "--", "info": "  "}

    def number(value, unit=""):
        if value is None:
            return "-"
        if unit == "%":
            return f"{value:.2f}%"
        if unit == "ms":
            return format_ms(value)
        if unit == "/min":
            return f"{value:,.0f}/min"
        return f"{value:,.0f}"

    lines = [f"{health['app']}: {health['status'].upper()}", "  trading execution"]
    for stage in health["stages"]:
        wait = number(stage["wait"], "ms")
        if stage["wait"] is not None and not stage.get("waitGraded"):
            wait += "*"
        run = number(stage["run"], "ms")
        rate = number(stage["rate"], "/min")
        extra = ""
        if stage.get("extra") is not None:
            extra = f"  {stage.get('extraLabel', 'extra')} {number(stage['extra'], 'ms')}"
        lines.append(
            f"    {marks[stage['grade']]:<5} {stage['label']:<17} "
            f"{rate:>11}  wait {wait:>7}  run {run:>7}{extra}"
        )

    lines.append("  (* request queue time -- not graded, see README)")
    lines.append("  application traffic")
    for metric in health["metrics"].values():
        detail = f" ({metric['detail']})" if metric.get("detail") else ""
        lines.append(
            f"    {marks[metric['grade']]:<5} {metric['label']:<17} "
            f"{number(metric['value'], metric['unit']):>11}{detail}"
        )

    for issue in health["issues"]:
        lines.append(f"  ISSUE {issue['priority']}: {issue['title']}")

    if health.get("externals"):
        lines.append(f"  external services ({len(health['externals'])} called in the last 5 min, slowest first)")
        for host in health["externals"]:
            lines.append(f"    {host['label']:<24} {host['ms']:>6.0f}ms {host['rpm']:>9,.0f}/min")
    return "\n".join(lines)


def main():
    as_json = "--json" in sys.argv[1:]
    try:
        health = collect()
    except Exception as error:  # noqa: BLE001 - one line out, whatever went wrong
        # Always valid JSON on stdout so the widget can show *why* it is grey
        # rather than just failing to parse. Never echo the exception verbatim
        # into a field the UI trusts beyond a message.
        failure = {"ok": False, "status": "unknown", "error": str(error) or error.__class__.__name__}
        if as_json:
            print(json.dumps(failure, separators=(",", ":")))
        else:
            print(f"unavailable: {failure['error']}", file=sys.stderr)
        return 1

    print(json.dumps(health, separators=(",", ":")) if as_json else format_human(health))
    return 0


if __name__ == "__main__":
    sys.exit(main())
